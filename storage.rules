rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 사용자 프로필 이미지 업로드 (임시 저장소)
    match /user_profile_images/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }
    
    // 처리된 프로필 이미지 (고정 경로, 캐시 최적화)
    match /user_profiles/{userId}/profile.webp {
      // 모든 인증된 사용자가 읽기 가능 (프로필 이미지는 공개)
      allow read: if request.auth != null;
      // Firebase Functions만 쓰기 가능 (서버에서 이미지 처리 후 저장)
      allow write: if false; // Functions는 Admin SDK 사용으로 이 규칙 우회
    }
    
    // 기타 파일들 - 기본 보안
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
